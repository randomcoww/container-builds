FROM docker.io/debian:testing-slim as build
ARG VERSION

RUN set -e \
  \
  && TARGETARCH=$(dpkg --print-architecture) \
  && TARGETARCH=$([ "$TARGETARCH" = "amd64" ] && echo "x64" || echo "$TARGETARCH") \
  \
  && apt update \
  && apt install -y --no-install-recommends \
    libgomp1 \
    curl \
    ca-certificates \
  \
  && curl -fsSL -o llama.tar.gz \
    https://github.com/unslothai/llama.cpp/releases/download/$VERSION/app-$VERSION-linux-$TARGETARCH-vulkan.tar.gz \
  && mkdir -p /llama.cpp \
  && tar xf llama.tar.gz --strip-components=1 -C /llama.cpp