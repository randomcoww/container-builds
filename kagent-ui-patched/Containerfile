ARG VERSION
FROM ghcr.io/kagent-dev/kagent/ui:$VERSION

# Switch to root to install dependencies and rename files
USER root

RUN apk add --no-cache --virtual .build-deps npm \
  && npm install undici --legacy-peer-deps \
  && apk del .build-deps

USER 1001

# Rename the original entrypoint
RUN mv server.js server-original.js

# Copy the wrapper script
COPY server.js server.js